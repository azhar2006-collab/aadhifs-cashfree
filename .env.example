# ═══════════════════════════════════════════════════════════════
# Aadhif's Wood Pressed Oils — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ═══════════════════════════════════════════════════════════════

# Server Port & Public Website URL
PORT=3000
WEBSITE_URL=http://localhost:3000
BUSINESS_NAME=Aadhif's Wood Pressed Oils

# Admin Panel Password (used to log into /admin)
ADMIN_PASSWORD=admin1234

# Cashfree Payment Gateway Credentials
# Set CASHFREE_ENV to 'TEST' for Sandbox or 'PROD' for Live Production
CASHFREE_ENV=TEST
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY

# WhatsApp Notification Phone Number (include country code without +, e.g. 919500887900)
OWNER_WHATSAPP=919500887900

# Gmail Notification Credentials (Optional, for instant email on paid orders)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
